<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.readora.controller.LibrarianLandingPageController"
            stylesheets="@style.css"
            styleClass="root-pane">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="top-bar">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>

            <VBox spacing="0">
                <Label text="Readora" styleClass="logo-title"/>
                <Label text="Librarian Portal" styleClass="logo-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Dashboard" onAction="#openDashboard" styleClass="menu-button-active"/>
                <Button text="Search Books" onAction="#openSearchBook" styleClass="menu-button"/>
                <Button text="Manage Members" onAction="#openManageStudent" styleClass="menu-button"/>
                <Button text="Borrowed Books" onAction="#openBorrowingRecords" styleClass="menu-button"/>
                <Button text="Return Books" onAction="#openReturnBook" styleClass="menu-button"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="librarianMenuButton"
                    text="☰"
                    onAction="#handleLibrarianMenu"
                    styleClass="profile-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll-pane">
            <content>
                <StackPane fx:id="contentArea">
                    <padding>
                        <Insets top="24" right="30" bottom="30" left="30"/>
                    </padding>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>