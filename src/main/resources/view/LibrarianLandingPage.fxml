<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="720.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.readora.controller.LibrarianLandingPage">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0"
              style="-fx-background-color: white; -fx-padding: 0 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <children>
                <VBox alignment="CENTER_LEFT">
                    <Label text="Readora" textFill="#1E3A8A">
                        <font><Font name="System Bold" size="26.0" /></font>
                    </Label>
                    <Label text="Librarian Workstation" textFill="#6B7280">
                        <font><Font size="12.0" /></font>
                    </Label>
                </VBox>

                <Pane HBox.hgrow="ALWAYS" />

                <HBox fx:id="navContainer" alignment="CENTER" spacing="15.0">
                    <Button onAction="#openDashboard" text="Dashboard"
                            style="-fx-background-color: #E0F2FE; -fx-text-fill: #0369A1; -fx-background-radius: 10; -fx-padding: 10 20; -fx-font-weight: bold;" />
                    <Button onAction="#openSearchBook" text="Catalog"
                            style="-fx-background-color: transparent; -fx-text-fill: #4B5563; -fx-padding: 10 20;" />
                    <Button onAction="#openManageMember" text="Members"
                            style="-fx-background-color: transparent; -fx-text-fill: #4B5563; -fx-padding: 10 20;" />
                    <Button onAction="#openBorrowingRecords" text="Circulation"
                            style="-fx-background-color: transparent; -fx-text-fill: #4B5563; -fx-padding: 10 20;" />
                </HBox>

                <Pane HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="12.0">
                    <VBox alignment="CENTER_RIGHT">
                        <Label text="Librarian" textFill="#1E3A8A">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <Label text="Active Session" textFill="#6B7280">
                            <font><Font size="11.0" /></font>
                        </Label>
                    </VBox>
                    <Button text="☰" style="-fx-background-color: transparent; -fx-padding: 10;" />
                </HBox>
            </children>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" />
    </center>

</BorderPane>