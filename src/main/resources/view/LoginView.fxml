<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane styleClass="root-pane"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.readora.controller.LoginViewController">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets bottom="14" left="24" right="24" top="14"/>
            </padding>

            <VBox spacing="0">
                <Label styleClass="logo-title" text="Readora"/>
                <Label styleClass="logo-subtitle" text="Smart Library Management System"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20" styleClass="login-page">

            <VBox alignment="CENTER" spacing="14" styleClass="login-card">
                <padding>
                    <Insets bottom="36" left="34" right="34" top="36"/>
                </padding>

                <StackPane styleClass="login-logo-circle-outer">
                    <ImageView fx:id="logoImage"
                               fitWidth="170"
                               fitHeight="170"
                               preserveRatio="false"
                               smooth="true">
                        <clip>
                            <Circle centerX="85" centerY="85" radius="85"/>
                        </clip>
                    </ImageView>
                </StackPane>

                <Label styleClass="login-title" text="Welcome Back"/>

                <Label styleClass="login-subtitle"
                       text="Access books, records, and library services in one place."/>

                <VBox maxWidth="320" spacing="8">
                    <Label styleClass="form-label" text="Username"/>
                    <TextField fx:id="usernameField"
                               promptText="Enter your username"
                               styleClass="login-input"/>
                </VBox>

                <VBox maxWidth="320" spacing="8">
                    <Label styleClass="form-label" text="Password"/>
                    <PasswordField fx:id="passwordField"
                                   promptText="Enter your password"
                                   styleClass="login-input"/>
                </VBox>

                <Button maxWidth="320"
                        onAction="#handleLogin"
                        styleClass="primary-login-button"
                        text="Login"/>

                <Button maxWidth="320"
                        onAction="#handleRegister"
                        styleClass="secondary-login-button"
                        text="Register"/>

                <Label styleClass="login-footer-text"
                       text="Library access starts here."/>
            </VBox>
        </VBox>
    </center>

</BorderPane>