<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.readora.controller.LoginViewController"
            stylesheets="@style.css"
            styleClass="root-pane">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>

            <VBox spacing="2">
                <Label text="Readora" styleClass="logo-title"/>
                <Label text="Smart Library Management System" styleClass="logo-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <StackPane styleClass="login-shell">
            <children>
                <VBox alignment="CENTER" spacing="24" styleClass="login-page">

                    <VBox alignment="CENTER" spacing="18" styleClass="login-card">
                        <padding>
                            <Insets top="36" right="38" bottom="34" left="38"/>
                        </padding>

                        <VBox alignment="CENTER" spacing="12">
                            <StackPane styleClass="login-logo-circle-outer">
                                <children>
                                    <StackPane styleClass="login-logo-circle-inner">
                                        <children>
                                            <ImageView fx:id="loginLogoView"
                                                       fitWidth="176"
                                                       fitHeight="176"
                                                       preserveRatio="false"
                                                       smooth="true">
                                                <clip>
                                                    <Circle radius="88" centerX="88" centerY="88"/>
                                                </clip>
                                            </ImageView>
                                        </children>
                                    </StackPane>
                                </children>
                            </StackPane>

                            <VBox alignment="CENTER" spacing="6">
                                <Label text="Welcome Back" styleClass="login-title"/>
                                <Label text="Access books, records, and library services in one place."
                                       styleClass="login-subtitle"/>
                            </VBox>
                        </VBox>

                        <VBox spacing="14" maxWidth="340">
                            <VBox spacing="7">
                                <Label text="Username" styleClass="form-label"/>
                                <TextField fx:id="usernameField"
                                           promptText="Enter your username"
                                           styleClass="login-input"/>
                            </VBox>

                            <VBox spacing="7">
                                <Label text="Password" styleClass="form-label"/>
                                <PasswordField fx:id="passwordField"
                                               promptText="Enter your password"
                                               styleClass="login-input"/>
                            </VBox>
                        </VBox>

                        <VBox spacing="12" maxWidth="340">
                            <Button text="Login"
                                    onAction="#handleLogin"
                                    styleClass="primary-login-button"
                                    maxWidth="1.7976931348623157E308"/>

                            <Button text="Register"
                                    onAction="#handleRegister"
                                    styleClass="secondary-login-button"
                                    maxWidth="1.7976931348623157E308"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="4">
                            <Label text="Library access starts here." styleClass="login-footer-text"/>
                        </VBox>
                    </VBox>

                </VBox>
            </children>
        </StackPane>
    </center>

</BorderPane>