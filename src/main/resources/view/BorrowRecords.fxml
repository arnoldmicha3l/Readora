<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.readora.controller.BorrowRecordsController"
            stylesheets="@style.css"
            styleClass="root-pane">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>

            <VBox spacing="0">
                <Label text="Readora" styleClass="logo-title"/>
                <Label text="Borrow Records" styleClass="logo-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Back to Dashboard"
                    onAction="#handleClose"
                    styleClass="menu-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="22" styleClass="dashboard-wrapper">
            <padding>
                <Insets top="30" right="34" bottom="34" left="34"/>
            </padding>

            <VBox spacing="5">
                <Label text="Borrow Records" styleClass="welcome-title"/>
                <Label text="Track borrowed, returned, and overdue books." styleClass="welcome-subtitle"/>
            </VBox>

            <HBox spacing="12" styleClass="section-panel">
                <TextField fx:id="searchField"
                           promptText="Search by record, book, student, status, or date..."
                           onKeyReleased="#handleSearch"
                           HBox.hgrow="ALWAYS"/>

                <ComboBox fx:id="statusFilter"
                          promptText="Status"
                          onAction="#handleSearch"
                          prefWidth="160"/>

                <Button text="Search"
                        onAction="#handleSearch"
                        styleClass="primary-action-button"/>

                <Button fx:id="clearButton"
                        text="Clear"
                        onAction="#handleClearSearch"
                        styleClass="secondary-action-button"/>

                <Button fx:id="returnButton"
                        text="Mark Returned"
                        onAction="#handleUpdateStatus"
                        styleClass="primary-action-button"
                        prefWidth="140"/>
            </HBox>

            <HBox spacing="12" styleClass="section-panel">
                <Label fx:id="selectedRecordLabel"
                       text="No record selected."
                       styleClass="welcome-subtitle"/>

                <Label fx:id="resultLabel"
                       text=""
                       styleClass="welcome-subtitle"/>
            </HBox>

            <VBox spacing="12" styleClass="table-panel" VBox.vgrow="ALWAYS">
                <Label text="All Borrow Records" styleClass="section-heading"/>

                <TableView fx:id="borrowTable"
                           styleClass="book-table"
                           prefHeight="520"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="Record ID" prefWidth="110"/>
                        <TableColumn fx:id="colBook" text="Book" prefWidth="260"/>
                        <TableColumn fx:id="colMember" text="Student" prefWidth="220"/>
                        <TableColumn fx:id="colBorrow" text="Borrow Date" prefWidth="140"/>
                        <TableColumn fx:id="colDue" text="Due Date" prefWidth="140"/>
                        <TableColumn fx:id="colReturn" text="Return Date" prefWidth="140"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

</BorderPane>