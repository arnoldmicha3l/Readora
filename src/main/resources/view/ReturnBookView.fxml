<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.readora.controller.ReturnBookController"
      spacing="22"
      styleClass="books-page">

    <VBox spacing="5">
        <Label text="Return Books" styleClass="welcome-title"/>
        <Label text="Select an active borrow record and mark it as returned." styleClass="welcome-subtitle"/>
    </VBox>

    <HBox spacing="12" styleClass="section-panel">
        <TextField fx:id="searchField"
                   promptText="Search records to return..."
                   onKeyReleased="#handleSearch"
                   HBox.hgrow="ALWAYS"/>

        <Button text="Search"
                onAction="#handleSearch"
                styleClass="primary-action-button"/>

        <Button fx:id="clearButton"
                text="Clear"
                onAction="#handleClearSearch"
                styleClass="secondary-action-button"/>

        <Button fx:id="returnButton"
                text="Return Selected"
                onAction="#handleReturn"
                styleClass="primary-action-button"
                prefWidth="145"/>
    </HBox>

    <HBox spacing="12" styleClass="section-panel">
        <Label fx:id="selectedRecordLabel"
               text="No record selected."
               styleClass="welcome-subtitle"/>

        <Label fx:id="resultLabel"
               text=""
               styleClass="welcome-subtitle"/>
    </HBox>

    <VBox spacing="12" styleClass="table-panel" VBox.vgrow="ALWAYS">
        <Label text="Records Available for Return" styleClass="section-heading"/>

        <TableView fx:id="table"
                   styleClass="book-table"
                   prefHeight="520"
                   VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="recordCol" text="Record ID" prefWidth="130"/>
                <TableColumn fx:id="studentCol" text="Student Name" prefWidth="260"/>
                <TableColumn fx:id="bookCol" text="Book Title" prefWidth="300"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>

</VBox>