<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.readora.controller.SearchBookController"
      spacing="22"
      styleClass="books-page">

    <VBox spacing="5">
        <Label text="Search Books" styleClass="welcome-title"/>
        <Label text="Search by book ID, title, author, category, or status." styleClass="welcome-subtitle"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="section-panel">
        <TextField fx:id="searchField"
                   promptText="Search books..."
                   onKeyReleased="#handleSearch"
                   HBox.hgrow="ALWAYS"/>

        <ComboBox fx:id="statusFilter"
                  promptText="Status"
                  onAction="#handleSearch"
                  prefWidth="160"/>

        <Button text="Search"
                onAction="#handleSearch"
                styleClass="primary-action-button"/>

        <Button text="Clear"
                onAction="#handleClearSearch"
                styleClass="secondary-action-button"/>
    </HBox>

    <VBox spacing="12" styleClass="table-panel" VBox.vgrow="ALWAYS">
        <Label text="Book Results" styleClass="section-heading"/>

        <TableView fx:id="table" styleClass="book-table" prefHeight="500" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" text="Book ID" prefWidth="130"/>
                <TableColumn fx:id="titleCol" text="Title" prefWidth="270"/>
                <TableColumn fx:id="authorCol" text="Author" prefWidth="220"/>
                <TableColumn fx:id="categoryCol" text="Category" prefWidth="170"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="140"/>
            </columns>
        </TableView>
    </VBox>

</VBox>