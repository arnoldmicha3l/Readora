<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.readora.controller.AdminViewController"
            stylesheets="@style.css"
            styleClass="root-pane">

  <children>
    <ScrollPane fitToWidth="true"
                styleClass="main-scroll"
                AnchorPane.topAnchor="0"
                AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0">

      <content>
        <BorderPane>

          <top>
            <HBox alignment="CENTER_LEFT" styleClass="top-bar">
              <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
              </padding>

              <VBox>
                <Label text="Readora" styleClass="logo-title"/>
                <Label text="Smart Library Management System" styleClass="logo-subtitle"/>
              </VBox>

              <Region HBox.hgrow="ALWAYS"/>

              <HBox spacing="10" alignment="CENTER">
                <Button text="Dashboard"
                        styleClass="menu-button-active"
                        onAction="#handleDashboard"/>

                <Button text="Books"
                        styleClass="menu-button"
                        onAction="#handleBooks"/>

                <Button text="Students"
                        styleClass="menu-button"
                        onAction="#handleStudents"/>

                <Button text="Borrow Records"
                        styleClass="menu-button"
                        onAction="#handleBorrowRecords"/>

                <Button text="Reports"
                        styleClass="menu-button"
                        onAction="#handleReports"/>
              </HBox>

              <Region HBox.hgrow="ALWAYS"/>

              <HBox spacing="10" alignment="CENTER_RIGHT">
                <VBox alignment="CENTER_RIGHT">
                  <Label text="Admin" styleClass="user-label"/>
                  <Label text="System Administrator" styleClass="user-role"/>
                </VBox>

                <Button fx:id="adminMenuButton"
                        text="☰"
                        styleClass="profile-button"
                        onAction="#handleMenu"/>
              </HBox>
            </HBox>
          </top>

          <center>
            <VBox spacing="24" styleClass="dashboard-wrapper">
              <padding>
                <Insets top="32" right="34" bottom="32" left="34"/>
              </padding>

              <VBox spacing="6">
                <Label text="Admin Dashboard" styleClass="welcome-title"/>
                <Label text="Manage books, students, borrowing records, reports, and system data."
                       styleClass="welcome-subtitle"/>
              </VBox>

              <HBox spacing="20">
                <VBox spacing="8" styleClass="stat-card" prefWidth="240">
                  <Label text="Book Management" styleClass="stat-label"/>
                  <Label text="Books" styleClass="stat-number"/>
                  <Button text="Open Books"
                          styleClass="secondary-action-button"
                          onAction="#handleBooks"/>
                </VBox>

                <VBox spacing="8" styleClass="stat-card" prefWidth="240">
                  <Label text="Student Records" styleClass="stat-label"/>
                  <Label text="Students" styleClass="stat-number"/>
                  <Button text="Open Students"
                          styleClass="secondary-action-button"
                          onAction="#handleStudents"/>
                </VBox>

                <VBox spacing="8" styleClass="stat-card" prefWidth="240">
                  <Label text="Borrowing Logs" styleClass="stat-label"/>
                  <Label text="Records" styleClass="stat-number"/>
                  <Button text="Open Records"
                          styleClass="secondary-action-button"
                          onAction="#handleBorrowRecords"/>
                </VBox>
              </HBox>

              <VBox spacing="14" styleClass="section-panel">
                <padding>
                  <Insets top="22" right="24" bottom="22" left="24"/>
                </padding>

                <Label text="System Overview" styleClass="section-heading"/>

                <Label text="Use the navigation above to manage the full Readora library workflow. All pages are connected to the system navigation and database services."
                       styleClass="welcome-subtitle"/>

                <HBox spacing="12">
                  <Button text="View Reports"
                          styleClass="primary-action-button"
                          onAction="#handleReports"/>

                  <Button text="Borrow Records"
                          styleClass="secondary-action-button"
                          onAction="#handleBorrowRecords"/>
                </HBox>
              </VBox>
            </VBox>
          </center>

        </BorderPane>
      </content>
    </ScrollPane>
  </children>
</AnchorPane>