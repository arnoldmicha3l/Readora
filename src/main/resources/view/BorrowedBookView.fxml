<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.readora.controller.BorrowedBookController"
      spacing="22"
      styleClass="books-page">

    <VBox spacing="5">
        <Label text="Borrowed Books" styleClass="welcome-title"/>
        <Label text="See who currently has each book and who is next in line through reservations."
               styleClass="welcome-subtitle"/>
    </VBox>

    <HBox spacing="18">
        <VBox spacing="8" styleClass="analytics-card-yellow" HBox.hgrow="ALWAYS">
            <Label text="Currently Borrowed" styleClass="analytics-title"/>
            <Label text="Active" styleClass="analytics-number"/>
            <Label text="Books currently with students" styleClass="analytics-subtitle"/>
        </VBox>

        <VBox spacing="8" styleClass="analytics-card-blue" HBox.hgrow="ALWAYS">
            <Label text="Reservation Queue" styleClass="analytics-title"/>
            <Label text="Next User" styleClass="analytics-number"/>
            <Label text="Shows who reserved the book next" styleClass="analytics-subtitle"/>
        </VBox>

        <VBox spacing="8" styleClass="analytics-card-red" HBox.hgrow="ALWAYS">
            <Label text="Overdue Watch" styleClass="analytics-title"/>
            <Label text="Alert" styleClass="analytics-number"/>
            <Label text="Overdue books need follow-up" styleClass="analytics-subtitle"/>
        </VBox>
    </HBox>

    <HBox spacing="12" styleClass="section-panel">
        <TextField fx:id="searchField"
                   promptText="Search by book, current borrower, next reserved student, status, or record ID..."
                   onKeyReleased="#handleSearch"
                   HBox.hgrow="ALWAYS"/>

        <Button text="Search"
                onAction="#handleSearch"
                styleClass="primary-action-button"/>

        <Button fx:id="clearButton"
                text="Clear"
                onAction="#handleClearSearch"
                styleClass="secondary-action-button"/>
    </HBox>

    <VBox spacing="12" styleClass="table-panel" VBox.vgrow="ALWAYS">
        <HBox spacing="12">
            <Label text="Active Borrow Records" styleClass="section-heading"/>
            <Label fx:id="resultLabel" text="" styleClass="welcome-subtitle"/>
        </HBox>

        <TableView fx:id="table"
                   styleClass="book-table"
                   prefHeight="520"
                   VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="recordCol" text="Record ID" prefWidth="120"/>
                <TableColumn fx:id="bookCol" text="Book Title" prefWidth="300"/>
                <TableColumn fx:id="currentBorrowerCol" text="Currently Borrowed By" prefWidth="250"/>
                <TableColumn fx:id="nextInLineCol" text="Next Reserved Student" prefWidth="250"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>

</VBox>