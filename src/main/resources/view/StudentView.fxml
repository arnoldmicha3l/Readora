<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.readora.controller.StudentViewController"
            stylesheets="@style.css"
            styleClass="root-pane">

    <children>
        <ScrollPane fitToWidth="true"
                    styleClass="main-scroll"
                    AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0">

            <content>
                <BorderPane>

                    <top>
                        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
                            <padding>
                                <Insets top="14" right="24" bottom="14" left="24"/>
                            </padding>

                            <VBox spacing="0" prefWidth="220">
                                <Label text="Readora" styleClass="logo-title"/>
                                <Label text="Student Portal" styleClass="logo-subtitle"/>
                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <HBox spacing="10" alignment="CENTER">
                                <Button text="My Dashboard" styleClass="menu-button-active" onAction="#handleDashboard"/>
                                <Button text="Browse Books" styleClass="menu-button" onAction="#handleBrowseBooks"/>
                                <Button text="My History" styleClass="menu-button" onAction="#handleHistoryTab"/>
                            </HBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <HBox spacing="10" alignment="CENTER_RIGHT" prefWidth="220">
                                <VBox alignment="CENTER_RIGHT" spacing="2">
                                    <Label text="Student User" styleClass="user-label"/>
                                    <Label text="Student Portal" styleClass="user-role"/>
                                </VBox>

                                <Button fx:id="studentMenuButton"
                                        text="☰"
                                        styleClass="profile-button"
                                        onAction="#handleStudentMenu"/>
                            </HBox>
                        </HBox>
                    </top>

                    <center>
                        <VBox spacing="24" styleClass="dashboard-wrapper">
                            <padding>
                                <Insets top="32" right="34" bottom="32" left="34"/>
                            </padding>

                            <HBox spacing="24" alignment="CENTER_LEFT" styleClass="student-hero-panel">
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label fx:id="welcomeNameLabel"
                                           text="Hello, Student User"
                                           styleClass="welcome-title"/>

                                    <Label fx:id="studentIdLabel"
                                           text="Student ID: STU-1000"
                                           styleClass="welcome-subtitle"/>

                                    <Label text="Browse available books, borrow your next read, and track your library activity in one place."
                                           wrapText="true"
                                           styleClass="welcome-subtitle"/>

                                    <HBox spacing="12">
                                        <Button text="Browse Books"
                                                styleClass="primary-action-button"
                                                onAction="#handleBrowseBooks"
                                                prefWidth="140"/>

                                        <Button text="My History"
                                                styleClass="secondary-action-button"
                                                onAction="#handleHistoryTab"
                                                prefWidth="140"/>
                                    </HBox>
                                </VBox>

                                <VBox spacing="6" alignment="CENTER" styleClass="student-mini-card">
                                    <Label text="READORA" styleClass="admin-mini-title"/>
                                    <Label text="Student Reading Hub" styleClass="admin-mini-subtitle"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="20">
                                <VBox spacing="8" styleClass="analytics-card-blue" HBox.hgrow="ALWAYS">
                                    <Label text="Borrowed Books" styleClass="analytics-title"/>
                                    <Label fx:id="totalBorrowedLabel" text="0" styleClass="analytics-number"/>
                                    <Label text="Books currently linked to your account" styleClass="analytics-subtitle"/>
                                </VBox>

                                <VBox spacing="8" styleClass="analytics-card-green" HBox.hgrow="ALWAYS">
                                    <Label text="Returned Books" styleClass="analytics-title"/>
                                    <Label fx:id="totalReturnedLabel" text="0" styleClass="analytics-number"/>
                                    <Label text="Books you have successfully returned" styleClass="analytics-subtitle"/>
                                </VBox>

                                <VBox spacing="8" styleClass="analytics-card-yellow" HBox.hgrow="ALWAYS">
                                    <Label text="Library Access" styleClass="analytics-title"/>
                                    <Label text="Active" styleClass="analytics-number"/>
                                    <Label text="Your student account is ready to use" styleClass="analytics-subtitle"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="20">
                                <VBox spacing="14" styleClass="student-dashboard-card" HBox.hgrow="ALWAYS">
                                    <Label text="📚 Browse Collection" styleClass="feature-title"/>
                                    <Label text="Explore book covers, view details, check availability, and borrow directly from the library."
                                           wrapText="true"
                                           styleClass="feature-subtitle"/>
                                    <Region VBox.vgrow="ALWAYS"/>
                                    <Button text="Open Books"
                                            styleClass="secondary-action-button"
                                            onAction="#handleBrowseBooks"/>
                                </VBox>

                                <VBox spacing="14" styleClass="student-dashboard-card" HBox.hgrow="ALWAYS">
                                    <Label text="🕘 My Borrowing History" styleClass="feature-title"/>
                                    <Label text="Review your borrowed books, returned records, and reading activity."
                                           wrapText="true"
                                           styleClass="feature-subtitle"/>
                                    <Region VBox.vgrow="ALWAYS"/>
                                    <Button text="View History"
                                            styleClass="secondary-action-button"
                                            onAction="#handleHistoryTab"/>
                                </VBox>

                                <VBox spacing="14" styleClass="student-dashboard-card" HBox.hgrow="ALWAYS">
                                    <Label text="✅ Easy Borrowing" styleClass="feature-title"/>
                                    <Label text="Select an available book, confirm borrowing, and let Readora track the record for you."
                                           wrapText="true"
                                           styleClass="feature-subtitle"/>
                                    <Region VBox.vgrow="ALWAYS"/>
                                    <Button text="Start Browsing"
                                            styleClass="secondary-action-button"
                                            onAction="#handleBrowseBooks"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="20" VBox.vgrow="ALWAYS">
                                <VBox spacing="14" styleClass="section-panel" HBox.hgrow="ALWAYS">
                                    <Label text="Student Flow" styleClass="section-heading"/>
                                    <Label text="1. Browse the collection → 2. Open book details → 3. Borrow an available book → 4. Track your history"
                                           wrapText="true"
                                           styleClass="welcome-subtitle"/>
                                </VBox>

                                <VBox spacing="14" styleClass="section-panel" HBox.hgrow="ALWAYS">
                                    <Label text="Quick Tip" styleClass="section-heading"/>
                                    <Label text="Use the Browse Books page to view book covers and check whether a title is available, reserved, or already borrowed."
                                           wrapText="true"
                                           styleClass="welcome-subtitle"/>
                                </VBox>
                            </HBox>

                        </VBox>
                    </center>

                </BorderPane>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>