<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.readora.controller.StudentViewController"
            stylesheets="@style.css"
            styleClass="root-pane">

    <children>
        <ScrollPane fitToWidth="true"
                    styleClass="main-scroll"
                    AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0">

            <content>
                <BorderPane>

                    <top>
                        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
                            <padding>
                                <Insets top="14" right="24" bottom="14" left="24"/>
                            </padding>

                            <VBox>
                                <Label text="Readora" styleClass="logo-title"/>
                                <Label text="Smart Library Management System" styleClass="logo-subtitle"/>
                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <HBox spacing="10" alignment="CENTER">
                                <Button text="My Dashboard"
                                        styleClass="menu-button-active"
                                        onAction="#handleDashboard"/>

                                <Button text="Browse Books"
                                        styleClass="menu-button"
                                        onAction="#handleBrowseBooks"/>

                                <Button text="My History"
                                        styleClass="menu-button"
                                        onAction="#handleHistoryTab"/>
                            </HBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <HBox spacing="10" alignment="CENTER_RIGHT">
                                <VBox alignment="CENTER_RIGHT">
                                    <Label text="Student User" styleClass="user-label"/>
                                    <Label text="Student Portal" styleClass="user-role"/>
                                </VBox>

                                <Button fx:id="studentMenuButton"
                                        text="☰"
                                        styleClass="profile-button"
                                        onAction="#handleStudentMenu"/>
                            </HBox>
                        </HBox>
                    </top>

                    <center>
                        <VBox spacing="24" styleClass="dashboard-wrapper">
                            <padding>
                                <Insets top="32" right="34" bottom="32" left="34"/>
                            </padding>

                            <VBox spacing="6">
                                <Label fx:id="welcomeNameLabel"
                                       text="Hello, Student User"
                                       styleClass="welcome-title"/>

                                <Label fx:id="studentIdLabel"
                                       text="Student ID: STU-1000"
                                       styleClass="welcome-subtitle"/>
                            </VBox>

                            <HBox spacing="20">
                                <VBox spacing="8" styleClass="stat-card" prefWidth="260">
                                    <Label text="Borrowed Books" styleClass="stat-label"/>
                                    <Label fx:id="totalBorrowedLabel"
                                           text="0"
                                           styleClass="stat-number"/>
                                </VBox>

                                <VBox spacing="8" styleClass="stat-card" prefWidth="260">
                                    <Label text="Returned Books" styleClass="stat-label"/>
                                    <Label fx:id="totalReturnedLabel"
                                           text="0"
                                           styleClass="stat-number"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="14" styleClass="section-panel">
                                <padding>
                                    <Insets top="22" right="24" bottom="22" left="24"/>
                                </padding>

                                <Label text="Student Dashboard" styleClass="section-heading"/>

                                <Label text="Access your library tools, browse available books, and review your borrowing history in one place."
                                       styleClass="welcome-subtitle"/>

                                <HBox spacing="12">
                                    <Button text="Browse Books"
                                            styleClass="primary-action-button"
                                            onAction="#handleBrowseBooks"/>

                                    <Button text="View My History"
                                            styleClass="secondary-action-button"
                                            onAction="#handleHistoryTab"/>
                                </HBox>
                            </VBox>

                        </VBox>
                    </center>

                </BorderPane>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>