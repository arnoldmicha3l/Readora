<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/20"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.readora.controller.StudentProfileController"
           stylesheets="@style.css"
           styleClass="root-pane">

    <children>
        <BorderPane styleClass="root-pane">

            <top>
                <HBox alignment="CENTER_LEFT" styleClass="top-bar">
                    <padding>
                        <Insets top="14" right="24" bottom="14" left="24"/>
                    </padding>
                    <VBox spacing="0">
                        <Label text="Readora" styleClass="logo-title"/>
                        <Label text="Smart Library Management System" styleClass="logo-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="10" alignment="CENTER">
                        <Button text="My Dashboard" styleClass="menu-button" onAction="#handleDashboard"/>
                        <Button text="Browse Books" styleClass="menu-button" onAction="#handleBrowseBooks"/>
                        <Button text="My History" styleClass="menu-button" onAction="#handleHistoryTab"/>
                    </HBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <VBox alignment="CENTER_RIGHT" spacing="2">
                            <Label text="Student User" styleClass="user-label"/>
                            <Label text="ID: 2024-0001" styleClass="user-role"/>
                        </VBox>
                        <Button text="☰" styleClass="profile-button"/>
                    </HBox>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true" styleClass="main-scroll-pane">
                    <content>
                        <AnchorPane styleClass="dashboard-wrapper">
                            <children>
                                <VBox spacing="24" maxWidth="800"
                                      AnchorPane.topAnchor="26.0"
                                      AnchorPane.leftAnchor="50.0"
                                      AnchorPane.rightAnchor="50.0">

                                    <VBox spacing="4">
                                        <Label text="Student Profile" styleClass="welcome-title"/>
                                        <Label text="Manage your personal information and account settings." styleClass="welcome-subtitle"/>
                                    </VBox>

                                    <VBox spacing="20" styleClass="section-panel">
                                        <padding>
                                            <Insets top="30" right="40" bottom="30" left="40"/>
                                        </padding>

                                        <VBox spacing="8">
                                            <Label text="Full Name" style="-fx-font-size: 14; -fx-font-weight: bold;" styleClass="section-heading"/>
                                            <HBox spacing="15">
                                                <VBox HBox.hgrow="ALWAYS" spacing="5">
                                                    <Label text="First Name" styleClass="user-role"/>
                                                    <TextField fx:id="firstNameField" promptText="First Name" prefHeight="35"/>
                                                </VBox>
                                                <VBox HBox.hgrow="ALWAYS" spacing="5">
                                                    <Label text="Middle Name" styleClass="user-role"/>
                                                    <TextField fx:id="middleNameField" promptText="Middle Name" prefHeight="35"/>
                                                </VBox>
                                                <VBox HBox.hgrow="ALWAYS" spacing="5">
                                                    <Label text="Last Name" styleClass="user-role"/>
                                                    <TextField fx:id="lastNameField" promptText="Last Name" prefHeight="35"/>
                                                </VBox>
                                            </HBox>
                                        </VBox>

                                        <HBox spacing="15">
                                            <VBox HBox.hgrow="ALWAYS" spacing="5">
                                                <Label text="Student ID" style="-fx-font-size: 14; -fx-font-weight: bold;" styleClass="section-heading"/>
                                                <TextField fx:id="idField" promptText="2024-XXXX" prefHeight="35"/>
                                            </VBox>
                                            <VBox prefWidth="150" spacing="5">
                                                <Label text="Age" style="-fx-font-size: 14; -fx-font-weight: bold;" styleClass="section-heading"/>
                                                <TextField fx:id="ageField" promptText="Age" prefHeight="35"/>
                                            </VBox>
                                            <VBox prefWidth="200" spacing="5">
                                                <Label text="Gender" style="-fx-font-size: 14; -fx-font-weight: bold;" styleClass="section-heading"/>
                                                <ComboBox fx:id="genderComboBox" promptText="Select" prefHeight="35" prefWidth="200"/>
                                            </VBox>
                                        </HBox>

                                        <HBox spacing="15">
                                            <VBox HBox.hgrow="ALWAYS" spacing="5">
                                                <Label text="Email Address" style="-fx-font-size: 14; -fx-font-weight: bold;" styleClass="section-heading"/>
                                                <TextField fx:id="emailField" promptText="student@email.com" prefHeight="35"/>
                                            </VBox>
                                            <VBox HBox.hgrow="ALWAYS" spacing="5">
                                                <Label text="Phone Number" style="-fx-font-size: 14; -fx-font-weight: bold;" styleClass="section-heading"/>
                                                <TextField fx:id="phoneField" promptText="+63 9XX XXX XXXX" prefHeight="35"/>
                                            </VBox>
                                        </HBox>

                                        <HBox spacing="15" alignment="BOTTOM_LEFT">
                                            <VBox HBox.hgrow="ALWAYS" spacing="5">
                                                <Label text="Username" style="-fx-font-size: 14; -fx-font-weight: bold;" styleClass="section-heading"/>
                                                <HBox spacing="10">
                                                    <TextField fx:id="usernameField"
                                                               promptText="Username"
                                                               prefHeight="35"
                                                               HBox.hgrow="ALWAYS"
                                                               editable="true"/>
                                                </HBox>
                                            </VBox>

                                            <VBox HBox.hgrow="ALWAYS" spacing="5">
                                                <Label text="Security" style="-fx-font-size: 14; -fx-font-weight: bold;" styleClass="section-heading"/>
                                                <Button text="Change Password"
                                                        onAction="#handleChangePassword"
                                                        styleClass="menu-button"
                                                        maxWidth="Infinity"
                                                        prefHeight="35"
                                                        style="-fx-font-size: 11; -fx-border-color: #d1d5db;"/>
                                            </VBox>
                                        </HBox>

                                        <Region prefHeight="10"/>

                                        <HBox spacing="15" alignment="CENTER_RIGHT">
                                            <Button text="Cancel"
                                                    onAction="#handleCancel"
                                                    styleClass="menu-button"
                                                    style="-fx-padding: 10 30; -fx-border-color: #d1d5db;"/>
                                            <Button text="Save Changes"
                                                    onAction="#handleSave"
                                                    styleClass="menu-button-active"
                                                    style="-fx-padding: 10 30;"/>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </children>
                        </AnchorPane>
                    </content>
                </ScrollPane>
            </center>

        </BorderPane>
    </children>
</StackPane>