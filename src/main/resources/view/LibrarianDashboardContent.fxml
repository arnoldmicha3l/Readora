<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="24"
      styleClass="dashboard-wrapper">

    <padding>
        <Insets top="30" right="34" bottom="34" left="34"/>
    </padding>

    <VBox spacing="6">
        <Label text="Librarian Dashboard" styleClass="welcome-title"/>
        <Label text="Manage daily circulation, member check-ins, and library catalog."
               styleClass="welcome-subtitle"/>
    </VBox>

    <HBox spacing="20">
        <VBox spacing="8" styleClass="stat-card" prefWidth="260">
            <Label text="Books Borrowed Today" styleClass="stat-label"/>
            <Label text="0" styleClass="stat-number"/>
        </VBox>

        <VBox spacing="8" styleClass="stat-card" prefWidth="260">
            <Label text="Returns Processed" styleClass="stat-label"/>
            <Label text="0" styleClass="stat-number"/>
        </VBox>

        <VBox spacing="8" styleClass="stat-card" prefWidth="260">
            <Label text="Overdue Alerts" styleClass="stat-label"/>
            <Label text="0" styleClass="stat-number"/>
        </VBox>
    </HBox>

    <VBox spacing="14" styleClass="section-panel">
        <Label text="Library Operations" styleClass="section-heading"/>

        <GridPane hgap="20" vgap="20">
            <VBox spacing="12" styleClass="feature-card" prefWidth="280" prefHeight="180"
                  GridPane.columnIndex="0" GridPane.rowIndex="0">

                <Label text="Circulation" styleClass="feature-title"/>
                <Label text="View currently borrowed and overdue books."
                       styleClass="feature-subtitle"
                       wrapText="true"/>

                <Button fx:id="openBorrowedButton"
                        text="Open Module"
                        styleClass="open-button"/>
            </VBox>

            <VBox spacing="12" styleClass="feature-card" prefWidth="280" prefHeight="180"
                  GridPane.columnIndex="1" GridPane.rowIndex="0">

                <Label text="Returns" styleClass="feature-title"/>
                <Label text="Process returned items and update book availability."
                       styleClass="feature-subtitle"
                       wrapText="true"/>

                <Button fx:id="openReturnButton"
                        text="Open Module"
                        styleClass="open-button"/>
            </VBox>
        </GridPane>
    </VBox>

</VBox>