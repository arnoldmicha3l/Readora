<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.readora.controller.ChangePasswordController"
            stylesheets="@style.css"
            styleClass="root-pane">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>

            <VBox spacing="0">
                <Label text="Readora" styleClass="logo-title"/>
                <Label text="Account Security" styleClass="logo-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Back"
                    onAction="#handleBack"
                    styleClass="secondary-login-button"
                    prefWidth="110"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20" styleClass="login-page">
            <VBox alignment="CENTER" spacing="16" styleClass="login-card">
                <padding>
                    <Insets top="36" right="34" bottom="36" left="34"/>
                </padding>

                <Label text="Change Password" styleClass="login-title"/>
                <Label text="Update your account password securely."
                       styleClass="login-subtitle"/>

                <VBox spacing="8" maxWidth="360">
                    <Label text="Current Password" styleClass="form-label"/>
                    <HBox spacing="8" alignment="CENTER">
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="currentPasswordField"
                                           promptText="Enter current password"
                                           styleClass="login-input"/>
                            <TextField fx:id="currentPasswordTextField"
                                       promptText="Enter current password"
                                       styleClass="login-input"/>
                        </StackPane>
                        <Button text="Show"
                                onAction="#toggleCurrentPassword"
                                styleClass="secondary-action-button"
                                prefWidth="80"/>
                    </HBox>
                </VBox>

                <VBox spacing="8" maxWidth="360">
                    <Label text="New Password" styleClass="form-label"/>
                    <HBox spacing="8" alignment="CENTER">
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="newPasswordField"
                                           promptText="Enter new password"
                                           styleClass="login-input"/>
                            <TextField fx:id="newPasswordTextField"
                                       promptText="Enter new password"
                                       styleClass="login-input"/>
                        </StackPane>
                        <Button text="Show"
                                onAction="#toggleNewPassword"
                                styleClass="secondary-action-button"
                                prefWidth="80"/>
                    </HBox>
                </VBox>

                <VBox spacing="8" maxWidth="360">
                    <Label text="Confirm New Password" styleClass="form-label"/>
                    <PasswordField fx:id="confirmPasswordField"
                                   promptText="Confirm new password"
                                   styleClass="login-input"/>
                </VBox>

                <Button text="Update Password"
                        onAction="#handleUpdate"
                        styleClass="primary-login-button"
                        maxWidth="360"/>

                <Button text="Back to Dashboard"
                        onAction="#handleBack"
                        styleClass="secondary-login-button"
                        maxWidth="360"/>

                <Label text="Use at least 6 characters."
                       styleClass="login-footer-text"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>