<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/20"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.readora.controller.ChangePasswordController"
           stylesheets="@style.css"
           styleClass="root-pane">
    <children>
        <AnchorPane styleClass="dashboard-wrapper">
            <children>
                <VBox spacing="20" prefWidth="450.0" styleClass="section-panel"
                      AnchorPane.topAnchor="100.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="200.0">
                    <padding>
                        <Insets top="30" right="40" bottom="30" left="40"/>
                    </padding>

                    <VBox spacing="5">
                        <Label text="Change Password" styleClass="welcome-title" style="-fx-font-size: 20;"/>
                        <Label text="Ensure your account is secure by using a strong password." styleClass="welcome-subtitle"/>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Current Password" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <StackPane HBox.hgrow="ALWAYS">
                                <PasswordField fx:id="currentPasswordField"
                                               prefHeight="35"
                                               maxWidth="Infinity" />
                                <TextField fx:id="currentPasswordTextField"
                                           visible="false"
                                           managed="true"
                                           prefHeight="35"
                                           maxWidth="Infinity" />
                            </StackPane>
                            <Button fx:id="showCurrentBtn" text="👁" onAction="#toggleCurrentPassword"
                                    styleClass="menu-button" prefHeight="35" minWidth="45"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="New Password" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <StackPane HBox.hgrow="ALWAYS">
                                <PasswordField fx:id="newPasswordField"
                                               prefHeight="35"
                                               maxWidth="Infinity" />
                                <TextField fx:id="newPasswordTextField"
                                           visible="false"
                                           managed="true"
                                           prefHeight="35"
                                           maxWidth="Infinity" />
                            </StackPane>
                            <Button fx:id="showNewBtn" text="👁" onAction="#toggleNewPassword"
                                    styleClass="menu-button" prefHeight="35" minWidth="45"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Confirm New Password" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                        <PasswordField fx:id="confirmPasswordField" prefHeight="35"/>
                    </VBox>

                    <HBox spacing="15" alignment="CENTER_RIGHT">
                        <Button text="Back to Profile" onAction="#handleBack" styleClass="menu-button" style="-fx-border-color: #d1d5db;"/>
                        <Button text="Update Password" onAction="#handleUpdate" styleClass="menu-button-active"/>
                    </HBox>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>