<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/20"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.readora.controller.BrowseBooksController"
           stylesheets="@style.css"
           styleClass="root-pane">

    <BorderPane styleClass="root-pane">

        <top>
            <HBox alignment="CENTER_LEFT" styleClass="top-bar">
                <padding>
                    <Insets top="14" right="24" bottom="14" left="24"/>
                </padding>

                <VBox spacing="0">
                    <Label text="Readora" styleClass="logo-title"/>
                    <Label text="Student Portal" styleClass="logo-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER">
                    <Button text="My Dashboard" styleClass="menu-button" onAction="#handleDashboard"/>
                    <Button text="Browse Books" styleClass="menu-button-active" onAction="#handleBrowseBooks"/>
                    <Button text="My History" styleClass="menu-button" onAction="#handleHistoryTab"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label text="Student User" styleClass="user-label"/>
                        <Label text="Student Portal" styleClass="user-role"/>
                    </VBox>

                    <Button fx:id="studentMenuButton"
                            text="☰"
                            styleClass="profile-button"
                            onAction="#handleStudentMenu"/>
                </HBox>
            </HBox>
        </top>

        <center>
            <VBox spacing="22" styleClass="dashboard-wrapper">
                <padding>
                    <Insets top="30" right="34" bottom="34" left="34"/>
                </padding>

                <VBox spacing="5">
                    <Label text="Browse Books" styleClass="welcome-title"/>
                    <Label text="Explore the library collection, view details, and borrow available books." styleClass="welcome-subtitle"/>
                </VBox>

                <HBox spacing="12" styleClass="section-panel">
                    <TextField fx:id="bookSearchField"
                               promptText="Search by title, author, category, status, or ID..."
                               onKeyReleased="#applyFilters"
                               HBox.hgrow="ALWAYS"/>

                    <ComboBox fx:id="genreFilter"
                              promptText="Category"
                              onAction="#applyFilters"
                              prefWidth="170"/>

                    <ComboBox fx:id="statusFilter"
                              promptText="Status"
                              onAction="#applyFilters"
                              prefWidth="150"/>

                    <Button text="Clear"
                            onAction="#handleClearFilters"
                            styleClass="secondary-action-button"/>

                    <Button text="Borrow Selected"
                            onAction="#handleBorrowBook"
                            styleClass="primary-action-button"
                            prefWidth="145"/>
                </HBox>

                <VBox spacing="14" styleClass="table-panel" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Library Collection" styleClass="section-heading"/>
                        <Label fx:id="bookCountLabel" text="" styleClass="welcome-subtitle"/>
                    </HBox>

                    <ScrollPane fitToWidth="true"
                                fitToHeight="true"
                                hbarPolicy="NEVER"
                                styleClass="books-scroll-pane"
                                VBox.vgrow="ALWAYS">
                        <content>
                            <FlowPane fx:id="booksFlowPane"
                                      hgap="22"
                                      vgap="26"
                                      prefWrapLength="1300"
                                      styleClass="books-grid">
                                <padding>
                                    <Insets top="8" right="8" bottom="18" left="8"/>
                                </padding>
                            </FlowPane>
                        </content>
                    </ScrollPane>
                </VBox>
            </VBox>
        </center>
    </BorderPane>

    <HBox fx:id="bookDetailsOverlay"
          alignment="CENTER"
          visible="false"
          managed="false"
          styleClass="popup-overlay">

        <HBox spacing="24" alignment="CENTER_LEFT" styleClass="book-details-card">
            <ImageView fx:id="detailsCoverImage"
                       fitWidth="180"
                       fitHeight="260"
                       preserveRatio="true"
                       styleClass="details-cover-image"/>

            <VBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="detailsTitleLabel"
                       text="Book Title"
                       wrapText="true"
                       styleClass="section-heading"/>

                <Label fx:id="detailsAuthorLabel"
                       text="Author"
                       styleClass="welcome-subtitle"/>

                <Label fx:id="detailsCategoryLabel"
                       text="Category"
                       styleClass="book-detail-text"/>

                <Label fx:id="detailsStatusLabel"
                       text="Status"
                       styleClass="book-detail-status"/>

                <Label text="Select this book to borrow it directly from your student portal."
                       wrapText="true"
                       styleClass="welcome-subtitle"/>

                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Close"
                            onAction="#handleCloseBookDetails"
                            styleClass="secondary-action-button"/>

                    <Button fx:id="detailsBorrowButton"
                            text="Borrow Book"
                            onAction="#handleBorrowFromDetails"
                            styleClass="primary-action-button"/>
                </HBox>
            </VBox>
        </HBox>
    </HBox>

</StackPane>