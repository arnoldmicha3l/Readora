<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.readora.controller.BrowseBooksController"
            stylesheets="@style.css"
            styleClass="root-pane">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>

            <VBox spacing="0">
                <Label text="Readora" styleClass="logo-title"/>
                <Label text="Student Portal" styleClass="logo-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER">
                <Button text="My Dashboard"
                        styleClass="menu-button"
                        onAction="#handleDashboard"/>

                <Button text="Browse Books"
                        styleClass="menu-button-active"
                        onAction="#handleBrowseBooks"/>

                <Button text="My History"
                        styleClass="menu-button"
                        onAction="#handleHistoryTab"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label text="Student User" styleClass="user-label"/>
                    <Label text="Student Portal" styleClass="user-role"/>
                </VBox>

                <Button fx:id="studentMenuButton"
                        text="☰"
                        styleClass="profile-button"
                        onAction="#handleStudentMenu"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="22" styleClass="dashboard-wrapper">
            <padding>
                <Insets top="30" right="34" bottom="34" left="34"/>
            </padding>

            <VBox spacing="5">
                <Label text="Browse Books" styleClass="welcome-title"/>
                <Label text="Search available books and borrow directly from the table." styleClass="welcome-subtitle"/>
            </VBox>

            <HBox spacing="12" styleClass="section-panel">
                <TextField fx:id="bookSearchField"
                           promptText="Search by title, author, category, status, or ID..."
                           onKeyReleased="#applyFilters"
                           HBox.hgrow="ALWAYS"/>

                <ComboBox fx:id="genreFilter"
                          promptText="Category"
                          onAction="#applyFilters"
                          prefWidth="170"/>

                <ComboBox fx:id="statusFilter"
                          promptText="Status"
                          onAction="#applyFilters"
                          prefWidth="150"/>

                <Button text="Clear"
                        onAction="#handleClearFilters"
                        styleClass="secondary-action-button"/>

                <Button text="Borrow Selected"
                        onAction="#handleBorrowBook"
                        styleClass="primary-action-button"
                        prefWidth="145"/>
            </HBox>

            <VBox spacing="12" styleClass="table-panel" VBox.vgrow="ALWAYS">
                <Label text="Library Collection" styleClass="section-heading"/>

                <TableView fx:id="booksTable"
                           styleClass="book-table"
                           prefHeight="520"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="isbnCol" text="Book ID" prefWidth="130"/>
                        <TableColumn fx:id="titleCol" text="Title" prefWidth="300"/>
                        <TableColumn fx:id="authorCol" text="Author" prefWidth="240"/>
                        <TableColumn fx:id="genreCol" text="Category" prefWidth="160"/>
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="140"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

</BorderPane>