<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.readora.controller.AdminReportsController"
            stylesheets="@style.css"
            styleClass="root-pane">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>

            <VBox spacing="0">
                <Label text="Readora" styleClass="logo-title"/>
                <Label text="Admin Reports" styleClass="logo-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Dashboard" onAction="#handleDashboard" styleClass="menu-button"/>
                <Button text="Books" onAction="#handleBooks" styleClass="menu-button"/>
                <Button text="Students" onAction="#handleStudents" styleClass="menu-button"/>
                <Button text="Borrow Records" onAction="#handleBorrowRecords" styleClass="menu-button"/>
                <Button text="Reports" onAction="#handleReports" styleClass="menu-button-active"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="24" styleClass="dashboard-wrapper">
            <padding>
                <Insets top="30" right="34" bottom="34" left="34"/>
            </padding>

            <VBox spacing="5">
                <Label text="Reports Dashboard" styleClass="welcome-title"/>
                <Label text="Monitor books, students, borrowed records, returns, and overdue activity." styleClass="welcome-subtitle"/>
            </VBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="Refresh Reports"
                        onAction="#handleRefreshReports"
                        styleClass="primary-action-button"
                        prefWidth="150"/>

                <Label fx:id="reportStatusLabel"
                       text="Reports loaded."
                       styleClass="welcome-subtitle"/>
            </HBox>

            <GridPane hgap="20" vgap="20">
                <VBox spacing="8" styleClass="stat-card" prefWidth="260" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Total Books" styleClass="stat-label"/>
                    <Label fx:id="totalBooksLabel" text="0" styleClass="stat-number"/>
                </VBox>

                <VBox spacing="8" styleClass="stat-card" prefWidth="260" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Total Students" styleClass="stat-label"/>
                    <Label fx:id="totalStudentsLabel" text="0" styleClass="stat-number"/>
                </VBox>

                <VBox spacing="8" styleClass="stat-card" prefWidth="260" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="Borrowed Books" styleClass="stat-label"/>
                    <Label fx:id="borrowedBooksLabel" text="0" styleClass="stat-number"/>
                </VBox>

                <VBox spacing="8" styleClass="stat-card" prefWidth="260" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Returned Records" styleClass="stat-label"/>
                    <Label fx:id="returnedBooksLabel" text="0" styleClass="stat-number"/>
                </VBox>

                <VBox spacing="8" styleClass="stat-card" prefWidth="260" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Overdue Records" styleClass="stat-label"/>
                    <Label fx:id="overdueLabel" text="0" styleClass="stat-number"/>
                </VBox>
            </GridPane>

            <VBox spacing="12" styleClass="section-panel">
                <Label text="Report Notes" styleClass="section-heading"/>
                <Label text="The report values are refreshed from the SQLite database. Overdue records are updated before totals are displayed."
                       wrapText="true"
                       styleClass="welcome-subtitle"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>