<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.readora.controller.MyHistoryController"
            stylesheets="@style.css"
            styleClass="root-pane">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>

            <VBox>
                <Label text="Readora" styleClass="logo-title"/>
                <Label text="Student Portal" styleClass="logo-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER">
                <Button text="My Dashboard"
                        styleClass="menu-button"
                        onAction="#handleDashboard"/>

                <Button text="Browse Books"
                        styleClass="menu-button"
                        onAction="#handleBrowseBooks"/>

                <Button text="My History"
                        styleClass="menu-button-active"
                        onAction="#handleHistoryTab"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="studentMenuButton"
                    text="☰"
                    styleClass="profile-button"
                    onAction="#handleStudentMenu"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="22" styleClass="dashboard-wrapper">
            <padding>
                <Insets top="30" right="34" bottom="34" left="34"/>
            </padding>

            <VBox spacing="5">
                <Label text="My Borrowing History" styleClass="welcome-title"/>
                <Label text="Track your borrowed, returned, and overdue books." styleClass="welcome-subtitle"/>
            </VBox>

            <HBox spacing="12" styleClass="section-panel">
                <TextField fx:id="searchField"
                           promptText="Search by record, book, status, or date..."
                           onKeyReleased="#handleSearch"
                           HBox.hgrow="ALWAYS"/>

                <Button text="Search"
                        onAction="#handleSearch"
                        styleClass="primary-action-button"/>

                <Button text="Clear"
                        onAction="#handleClearSearch"
                        styleClass="secondary-action-button"/>
            </HBox>

            <VBox spacing="12" styleClass="table-panel" VBox.vgrow="ALWAYS">
                <Label text="History Records" styleClass="section-heading"/>

                <TableView fx:id="historyTable"
                           styleClass="book-table"
                           prefHeight="520"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="recordIdCol" text="Record ID" prefWidth="120"/>
                        <TableColumn fx:id="bookCol" text="Book Title" prefWidth="300"/>
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="130"/>
                        <TableColumn fx:id="borrowDateCol" text="Borrow Date" prefWidth="150"/>
                        <TableColumn fx:id="dueDateCol" text="Due Date" prefWidth="150"/>
                        <TableColumn fx:id="returnDateCol" text="Return Date" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

</BorderPane>