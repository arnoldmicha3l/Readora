<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.readora.controller.MyHistoryController"
            stylesheets="@style.css"
            styleClass="root-pane">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>

            <VBox spacing="0" prefWidth="220">
                <Label text="Readora" styleClass="logo-title"/>
                <Label text="Student Portal" styleClass="logo-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER">
                <Button text="My Dashboard" styleClass="menu-button" onAction="#handleDashboard"/>
                <Button text="Browse Books" styleClass="menu-button" onAction="#handleBrowseBooks"/>
                <Button text="My History" styleClass="menu-button-active" onAction="#handleHistoryTab"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER_RIGHT" prefWidth="220">
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label text="Student User" styleClass="user-label"/>
                    <Label text="Student Portal" styleClass="user-role"/>
                </VBox>

                <Button fx:id="studentMenuButton"
                        text="☰"
                        styleClass="profile-button"
                        onAction="#handleStudentMenu"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="22" styleClass="dashboard-wrapper">
            <padding>
                <Insets top="30" right="34" bottom="34" left="34"/>
            </padding>

            <VBox spacing="5">
                <Label text="My Borrowing History" styleClass="welcome-title"/>
                <Label text="A simple overview of your borrowed, returned, and overdue books." styleClass="welcome-subtitle"/>
            </VBox>

            <HBox spacing="18">
                <VBox spacing="8" styleClass="analytics-card-blue" HBox.hgrow="ALWAYS">
                    <Label text="Total Records" styleClass="analytics-title"/>
                    <Label fx:id="totalHistoryLabel" text="0" styleClass="analytics-number"/>
                    <Label text="All borrowing activity" styleClass="analytics-subtitle"/>
                </VBox>

                <VBox spacing="8" styleClass="analytics-card-yellow" HBox.hgrow="ALWAYS">
                    <Label text="Borrowed" styleClass="analytics-title"/>
                    <Label fx:id="borrowedHistoryLabel" text="0" styleClass="analytics-number"/>
                    <Label text="Books not yet returned" styleClass="analytics-subtitle"/>
                </VBox>

                <VBox spacing="8" styleClass="analytics-card-green" HBox.hgrow="ALWAYS">
                    <Label text="Returned" styleClass="analytics-title"/>
                    <Label fx:id="returnedHistoryLabel" text="0" styleClass="analytics-number"/>
                    <Label text="Completed returns" styleClass="analytics-subtitle"/>
                </VBox>

                <VBox spacing="8" styleClass="analytics-card-red" HBox.hgrow="ALWAYS">
                    <Label text="Overdue" styleClass="analytics-title"/>
                    <Label fx:id="overdueHistoryLabel" text="0" styleClass="analytics-number"/>
                    <Label text="Needs attention" styleClass="analytics-subtitle"/>
                </VBox>
            </HBox>

            <HBox spacing="12" styleClass="section-panel">
                <TextField fx:id="searchField"
                           promptText="Search by book title, status, record ID, or date..."
                           onKeyReleased="#handleSearch"
                           HBox.hgrow="ALWAYS"/>

                <Button text="Search"
                        onAction="#handleSearch"
                        styleClass="primary-action-button"/>

                <Button text="Clear"
                        onAction="#handleClearSearch"
                        styleClass="secondary-action-button"/>
            </HBox>

            <VBox spacing="12" styleClass="table-panel" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="History Records" styleClass="section-heading"/>
                    <Label fx:id="historyResultLabel" text="" styleClass="welcome-subtitle"/>
                </HBox>

                <TableView fx:id="historyTable"
                           styleClass="book-table"
                           prefHeight="500"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="recordIdCol" text="Record ID" prefWidth="120"/>
                        <TableColumn fx:id="bookCol" text="Book Title" prefWidth="340"/>
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="150"/>
                        <TableColumn fx:id="borrowDateCol" text="Borrow Date" prefWidth="160"/>
                        <TableColumn fx:id="dueDateCol" text="Due Date" prefWidth="160"/>
                        <TableColumn fx:id="returnDateCol" text="Return Date" prefWidth="160"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

</BorderPane>