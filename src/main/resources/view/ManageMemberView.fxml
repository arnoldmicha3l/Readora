<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.readora.controller.ManageMemberController"
      spacing="22"
      styleClass="books-page">

    <VBox spacing="5">
        <Label text="Manage Members" styleClass="welcome-title"/>
        <Label text="View all registered student members in the library system." styleClass="welcome-subtitle"/>
    </VBox>

    <VBox spacing="12" styleClass="table-panel" VBox.vgrow="ALWAYS">
        <Label text="Student Members" styleClass="section-heading"/>

        <TableView fx:id="table" styleClass="book-table" prefHeight="520" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" text="Student ID" prefWidth="170"/>
                <TableColumn fx:id="nameCol" text="Full Name" prefWidth="300"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="160"/>
            </columns>
        </TableView>
    </VBox>

</VBox>