<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/20"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.readora.controller.BookFormViewController"
           stylesheets="@style.css"
           styleClass="root-pane">

    <BorderPane styleClass="root-pane">
        <top>
            <HBox alignment="CENTER_LEFT" styleClass="top-bar">
                <padding>
                    <Insets top="14" right="24" bottom="14" left="24"/>
                </padding>

                <VBox spacing="0">
                    <Label text="Readora" styleClass="logo-title"/>
                    <Label text="Admin Portal" styleClass="logo-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER">
                    <Button text="Dashboard" onAction="#handleGoDashboard" styleClass="menu-button"/>
                    <Button text="Books" onAction="#handleBooksTab" styleClass="menu-button-active"/>
                    <Button text="Students" onAction="#handleMembersTab" styleClass="menu-button"/>
                    <Button text="Borrow Records" onAction="#handleBorrowRecordsTab" styleClass="menu-button"/>
                    <Button text="Reports" onAction="#handleReportsTab" styleClass="menu-button"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="adminMenuButton"
                        text="☰"
                        styleClass="profile-button"
                        onAction="#handleAdminMenu"/>
            </HBox>
        </top>

        <center>
            <VBox spacing="22" styleClass="dashboard-wrapper">
                <padding>
                    <Insets top="30" right="34" bottom="34" left="34"/>
                </padding>

                <VBox spacing="5">
                    <Label text="Book Management" styleClass="welcome-title"/>
                    <Label text="Add, edit, delete, search, and filter library books." styleClass="welcome-subtitle"/>
                </VBox>

                <HBox spacing="12" styleClass="section-panel">
                    <TextField fx:id="searchField"
                               promptText="Search by ID, title, author, category, or status..."
                               onKeyReleased="#handleSearch"
                               HBox.hgrow="ALWAYS"/>

                    <ComboBox fx:id="filterCategoryComboBox"
                              promptText="Category"
                              onAction="#handleFilter"
                              prefWidth="170"/>

                    <ComboBox fx:id="filterStatusComboBox"
                              promptText="Status"
                              onAction="#handleFilter"
                              prefWidth="150"/>

                    <Button text="Clear"
                            onAction="#handleClearFilters"
                            styleClass="secondary-action-button"/>

                    <Button text="+ Add Book"
                            onAction="#handleOpenAddPopup"
                            styleClass="primary-action-button"
                            prefWidth="120"/>
                </HBox>

                <VBox spacing="12" styleClass="table-panel" VBox.vgrow="ALWAYS">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Book Records" styleClass="section-heading"/>
                        <Label fx:id="resultLabel" text="" styleClass="welcome-subtitle"/>
                    </HBox>

                    <TableView fx:id="bookTable"
                               styleClass="book-table"
                               prefHeight="520"
                               VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="coverColumn" text="Cover" prefWidth="90"/>
                            <TableColumn fx:id="bookIdColumn" text="Book ID" prefWidth="120"/>
                            <TableColumn fx:id="titleColumn" text="Title" prefWidth="260"/>
                            <TableColumn fx:id="authorColumn" text="Author" prefWidth="210"/>
                            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150"/>
                            <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                            <TableColumn fx:id="actionColumn" text="Actions" prefWidth="170"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </center>
    </BorderPane>

    <HBox fx:id="popupOverlay"
          alignment="CENTER"
          visible="false"
          managed="false"
          styleClass="popup-overlay">

        <VBox spacing="14" styleClass="popup-card">
            <Label fx:id="popupTitleLabel"
                   text="Add New Book"
                   styleClass="section-heading"/>

            <VBox spacing="6">
                <Label text="Book ID" styleClass="form-label"/>
                <TextField fx:id="bookIdField" promptText="e.g. B006"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Title" styleClass="form-label"/>
                <TextField fx:id="titleField" promptText="Book title"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Author" styleClass="form-label"/>
                <TextField fx:id="authorField" promptText="Author name"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Category" styleClass="form-label"/>
                <ComboBox fx:id="categoryComboBox" promptText="Select category" prefWidth="380"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Status" styleClass="form-label"/>
                <ComboBox fx:id="statusComboBox" promptText="Select status" prefWidth="380"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Book Cover" styleClass="form-label"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <ImageView fx:id="coverPreview"
                               fitWidth="90"
                               fitHeight="120"
                               preserveRatio="true"
                               styleClass="book-cover-preview"/>

                    <Button text="Choose Cover"
                            onAction="#handleChooseCover"
                            styleClass="secondary-action-button"/>
                </HBox>
            </VBox>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Cancel"
                        onAction="#handleCancelPopup"
                        styleClass="secondary-action-button"/>

                <Button text="Save"
                        onAction="#handleSaveBook"
                        styleClass="primary-action-button"/>
            </HBox>
        </VBox>
    </HBox>

</StackPane>